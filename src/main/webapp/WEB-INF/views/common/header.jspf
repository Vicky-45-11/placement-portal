<c:set var="ctx" value="${pageContext.request.contextPath}" />
<c:set var="role" value="${sessionScope.role}" />
<c:set var="area" value="${fn:toLowerCase(role)}" />
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${empty pageTitle ? 'Placement Cell' : pageTitle}"/> · Placement Cell</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="${ctx}/assets/style.css">
</head>
<body class="${empty role ? 'public' : 'app'}">
<header class="masthead">
    <div class="mast-inner">
        <a href="${ctx}/" class="wordmark">
            <span class="seal" aria-hidden="true">PC</span>
            <span><b>Placement Cell</b><small>Drives · Applications · Offers</small></span>
        </a>
        <c:choose>
            <c:when test="${not empty role}">
                <div class="who">
                    <button type="button" class="palette-btn" hidden title="Quick jump (Ctrl+K)"><span class="lbl">Jump to</span><span class="kbd">Ctrl K</span></button>
                    <span class="who-name"><c:out value="${sessionScope.userName}"/></span>
                    <span class="who-role"><c:out value="${role == 'COMPANY' ? sessionScope.companyName : (role == 'ADMIN' ? 'Placement officer' : 'Student')}"/></span>
                    <form method="post" action="${ctx}/logout" class="inline"><input type="hidden" name="_csrf" value="${sessionScope.csrf}"><button class="text-btn">Log out</button></form>
                </div>
            </c:when>
            <c:otherwise>
                <div class="actions"><a class="btn quiet" href="${ctx}/login">Log in</a><a class="btn" href="${ctx}/register">Register</a></div>
            </c:otherwise>
        </c:choose>
    </div>
    <c:if test="${not empty role}">
    <nav class="tabsbar" aria-label="Main">
        <div class="mast-inner tabs-inner">
            <c:choose>
                <c:when test="${role == 'ADMIN'}">
                    <a href="${ctx}/admin/" class="${nav == 'dashboard' ? 'on' : ''}">Overview</a>
                    <a href="${ctx}/admin/students" class="${nav == 'students' ? 'on' : ''}">Students</a>
                    <a href="${ctx}/admin/companies" class="${nav == 'companies' ? 'on' : ''}">Companies</a>
                    <a href="${ctx}/admin/jobs" class="${nav == 'jobs' ? 'on' : ''}">Drives</a>
                    <a href="${ctx}/admin/applications" class="${nav == 'applications' ? 'on' : ''}">Applications</a>
                    <a href="${ctx}/admin/interviews" class="${nav == 'interviews' ? 'on' : ''}">Interviews</a>
                    <a href="${ctx}/admin/reports" class="${nav == 'reports' ? 'on' : ''}">Reports</a>
                    <a href="${ctx}/admin/announcements" class="${nav == 'announcements' ? 'on' : ''}">Notices</a>
                </c:when>
                <c:when test="${role == 'STUDENT'}">
                    <a href="${ctx}/student/" class="${nav == 'dashboard' ? 'on' : ''}">My desk</a>
                    <a href="${ctx}/student/jobs" class="${nav == 'jobs' ? 'on' : ''}">Drives</a>
                    <a href="${ctx}/student/applications" class="${nav == 'applications' ? 'on' : ''}">My applications</a>
                    <a href="${ctx}/student/profile" class="${nav == 'profile' ? 'on' : ''}">Profile &amp; resume</a>
                </c:when>
                <c:when test="${role == 'COMPANY'}">
                    <a href="${ctx}/company/" class="${nav == 'dashboard' ? 'on' : ''}">Overview</a>
                    <a href="${ctx}/company/jobs" class="${nav == 'jobs' ? 'on' : ''}">My drives</a>
                    <a href="${ctx}/company/job/new" class="${nav == 'newjob' ? 'on' : ''}">Post a drive</a>
                    <a href="${ctx}/company/interviews" class="${nav == 'interviews' ? 'on' : ''}">Interviews</a>
                    <a href="${ctx}/company/profile" class="${nav == 'profile' ? 'on' : ''}">Company profile</a>
                </c:when>
            </c:choose>
            <a href="${ctx}/account" class="end ${nav == 'account' ? 'on' : ''}">Password</a>
        </div>
    </nav>
    </c:if>
</header>
<main class="wrap">
<c:if test="${not empty sessionScope.flash}"><div class="alert ok" role="status"><c:out value="${sessionScope.flash}"/></div><c:remove var="flash" scope="session"/></c:if>
<c:if test="${not empty sessionScope.flashError}"><div class="alert bad" role="alert"><c:out value="${sessionScope.flashError}"/></div><c:remove var="flashError" scope="session"/></c:if>
<c:if test="${not empty error}"><div class="alert bad" role="alert"><c:out value="${error}"/></div></c:if>
