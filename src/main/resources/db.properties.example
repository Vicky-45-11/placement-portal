# Copy this file to db.properties (same folder) and fill in your MySQL details.
# db.properties is git-ignored so your password never gets committed.
#
# Every value can also be set with an environment variable, which wins over this file:
#   DB_URL, DB_USER, DB_PASSWORD, UPLOAD_DIR

db.url=jdbc:mysql://localhost:3306/placement_db?useSSL=false&allowPublicKeyRetrieval=true&connectionTimeZone=SERVER
db.user=placement_app
db.password=change_me

# Folder where uploaded resumes (PDF) are stored. Created if missing.
upload.dir=uploads
